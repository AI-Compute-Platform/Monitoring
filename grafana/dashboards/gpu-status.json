{
  "uid": "gpu-status",
  "title": "GPU Status",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "time": { "from": "now-1h", "to": "now" },
  "refresh": "15s",
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "GPU 0 Memory",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "max by (gpu) (DCGM_FI_DEV_FB_USED{gpu=\"0\"})", "legendFormat": "Used", "refId": "A" },
        { "expr": "max by (gpu) (DCGM_FI_DEV_FB_FREE{gpu=\"0\"})", "legendFormat": "Free", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "decmbytes", "min": 0, "custom": { "fillOpacity": 10, "lineWidth": 2 } } }
    },
    {
